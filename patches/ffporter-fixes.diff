+    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<T7WalkIndex, Dictionary<(int, string), int>> ByName = new();
+
+    // The asset a pointer target in `zone` belongs to: the asset whose data holds it, the asset of a table entry, or
+    // the asset an inline registration cell names (these resolve by name at link time, so the asset must be present).
+    public static int ReferencedAsset(T7WalkIndex zone, long field, T7BlockAddress target)
+    {
+        if (zone.TryAliasOwner(target, out int owner))
+            return owner;
+        if (!zone.TryFileOffset(target, out long offset, field))
+            return -1;
+        long table = zone.List.AssetTableOffset;
+        if (offset >= table && offset < table + 16L * zone.List.Assets.Count)
+            return (int)((offset - table) / 16);
+        int asset = zone.AssetAt(offset);
+        if (asset >= 0)
+            return asset;
+        if (!zone.Pointers.TryGetValue(offset, out var cell) || cell.Kind is not (T7PointerKind.Inline or T7PointerKind.InlineAlias))
+            return -1;
+        int type;
+        string? name;
+        if (zone.TryInlineRegistration(offset, out T7Walk.Registration exact))
+            (type, name) = (exact.Type, exact.Name);
+        else if (!zone.TryRegistrationAt(cell.Target, offset, out type, out name))
+            return -1;
+        if (string.IsNullOrEmpty(name))
+            return -1;
+        Dictionary<(int, string), int> byName = ByName.GetValue(zone, z =>
+        {
+            var map = new Dictionary<(int, string), int>();
+            foreach (T7Walk.Asset a in z.Walk.Assets)
+                if (!string.IsNullOrEmpty(a.Name) && a.Reads.Count > 0)
+                    map.TryAdd((a.Type, a.Name), a.Index);
+            return map;
+        });
+        return byName.TryGetValue((type, name), out int found) ? found : -1;
+    }
+
+    // The other assets of `zone` that `asset`'s data points into (the PS4 linker stores shared data once).
+    public static IEnumerable<int> Dependencies(T7WalkIndex zone, T7Walk.Asset asset)
+    {
+        var spans = new List<(long Start, long Size)> { (asset.Start, asset.End - asset.Start) };
+        spans.AddRange(asset.Deferred.Select(d => (d.FileOffset, d.Size)));
+        var seen = new HashSet<int>();
+        foreach ((long start, long size) in spans)
+        {
+            foreach ((long field, T7PointerKind kind, T7BlockAddress target) in zone.PointersIn(start, size))
+            {
+                if (kind is not (T7PointerKind.Packed or T7PointerKind.PackedAlias))
+                    continue;
+                int other = ReferencedAsset(zone, field, target);
+                if (other >= 0 && other != asset.Index && seen.Add(other))
+                    yield return other;
+            }
+        }
+    }
+
+    private static bool IsShaderSet(int type) => type is T7AssetTypes.TechniqueSet or T7AssetTypes.ComputeShaderSet;
+
+    // Size of the assets a copy of `asset` must carry along, or -1 when that pulls in anything but shader sets
+    // (a weapon or material that happens to hold the shared data drags whole animation sets with it).
+    private int CarryCost(T7WalkIndex zone, T7Walk.Asset asset, int limit = 64)
+    {
+        var seen = new HashSet<int> { asset.Index };
+        var queue = new Queue<T7Walk.Asset>([asset]);
+        while (queue.Count > 0)
+        {
+            foreach (int other in Dependencies(zone, queue.Dequeue()))
+            {
+                if (!seen.Add(other))
+                    continue;
+                T7Walk.Asset dependency = zone.Walk.Assets[other];
+                if (!IsShaderSet(dependency.Type) || seen.Count > limit)
+                    return -1;
+                queue.Enqueue(dependency);
+            }
+        }
+        return seen.Count - 1;
+    }
