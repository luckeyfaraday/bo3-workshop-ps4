+    public string? Nearest(int type, string ps4Name) => Ranked(type, ps4Name).FirstOrDefault(c => TryFind(type, c, out _, out _));
+
+    // Like Nearest, but only a technique set with a copy the port can carry whole (its shared data sits in shader sets
+    // only): the retail PS4 zones store each shader program once, where it first appears, often inside a model.
+    public string? NearestClean(int type, string ps4Name, int tries = 12)
+    {
+        foreach (string candidate in Ranked(type, ps4Name).Take(tries))
+        {
+            if (TryFindForCopy(type, candidate, out _, out _, out bool clean, extraZones: 1) && clean)
+                return candidate;
+        }
+        return null;
+    }
+
+    // Technique sets of the same folder and '#hash' family as `ps4Name`, closest first (most shared name words, then
+    // fewest extra ones).
+    private IEnumerable<string> Ranked(int type, string ps4Name)
+    {
+        (string folder, string[] words, string hash) = Parts(ps4Name);
+        var scored = new List<(int Score, string Name)>();
+        foreach (string candidate in _catalog.Keys.Concat(_assets.Keys.Where(k => k.Type == type).Select(k => k.Name)).Distinct())
+        {
+            if (candidate == ps4Name)
+                continue;
+            (string f, string[] w, string h) = Parts(candidate);
+            if (f != folder || h != hash)
+                continue;
+            int shared = w.Intersect(words).Count();
+            // Only drop features, never add them: a technique set with extra name words ("_advanced", "_detail", ...)
+            // samples textures the map's material doesn't have, and the renderer's texture lookup then runs off the
+            // material's table (LEVIATHAN crashed entering a room: lit_vertscale_alphatest_nocull had become
+            // lit_alphatest_nocull_advanced).
+            if (shared == 0)
+                continue;
+            // Supersets only as a last resort (when nothing drops features): fewest extra words first.
+            int extra = w.Count(x => !words.Contains(x));
+            scored.Add((extra == 0 ? shared * 10 - words.Except(w).Count() : -1000 * extra + shared, candidate));
+        }
+        foreach ((int _, string name) in scored.OrderByDescending(s => s.Score).ThenBy(s => s.Name, StringComparer.Ordinal))
+            yield return name;
+        // Folderless technique sets are screen and 2D effects (e.g. Moon's helmet visor, "moon_helmet"); when none shares
+        // a name word, a plain alpha-blended 2D overlay draws it.
+        if (folder.Length == 0)
+            yield return $"2d_blend#{hash}";
+    }
+
+    private static (string Folder, string[] Words, string Hash) Parts(string name)
+    {
+        int hashAt = name.LastIndexOf('#');
+        string hash = hashAt > 0 ? name[(hashAt + 1)..] : "";
+        string stem = hashAt > 0 ? name[..hashAt] : name;
+        int slash = stem.LastIndexOf('/');
+        return (slash >= 0 ? stem[..slash] : "", stem[(slash + 1)..].Split('_', StringSplitOptions.RemoveEmptyEntries), hash);
+    }
