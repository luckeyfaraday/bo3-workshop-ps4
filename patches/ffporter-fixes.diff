+    // Drops the walked zones no output copies from (each holds its whole decompressed zone), so the linker's walks have
+    // the memory; a later zone that needs one walks it again from the cached walk on disk.
+    public int Release(IReadOnlySet<string> keepLabels)
+    {
+        List<T7WalkIndex> drop = _zones.Where(z => !keepLabels.Contains(z.Label)).ToList();
+        if (drop.Count == 0)
+            return 0;
