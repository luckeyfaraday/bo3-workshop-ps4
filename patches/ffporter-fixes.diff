+    public int AddScriptString(string? text)
+    {
+        if (text != null)
+        {
+            if (_stringIndex.TryGetValue(text, out int existing))
+                return existing;
+            _stringIndex[text] = ScriptStrings.Count;
+        }
+        ScriptStrings.Add(text);
+        return ScriptStrings.Count - 1;
