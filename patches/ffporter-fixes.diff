+    // Like TryFind, for a shader set that will be copied into the output: prefer the copy with the fewest shared
+    // shader sets to carry, walking a few more zones that have the name when the loaded copies drag in other assets.
+    public bool TryFindForCopy(int type, string name, out T7WalkIndex? zone, out T7Walk.Asset? asset, int extraZones = 16) =>
+        TryFindForCopy(type, name, out zone, out asset, out _, extraZones);
+
+    // `clean`: the copy found carries only shader sets along (false: it points into a model or other asset).
+    public bool TryFindForCopy(int type, string name, out T7WalkIndex? zone, out T7Walk.Asset? asset, out bool clean, int extraZones = 16)
+    {
+        clean = false;
+        if (!TryFind(type, name, out zone, out asset))
+            return false;
+        (T7WalkIndex Zone, T7Walk.Asset Asset)? best = null;
+        int bestCost = int.MaxValue;
+        void Consider()
+        {
+            foreach (var c in _assets[(type, name)])
+            {
+                int cost = CarryCost(c.Zone, c.Asset);
+                if (cost >= 0 && (cost < bestCost || (cost == bestCost && string.Equals(c.Zone.Label, PreferredZone, StringComparison.OrdinalIgnoreCase))))
+                {
+                    best = c;
+                    bestCost = cost;
+                }
+            }
+        }
+        Consider();
+        if (best == null && _catalog.TryGetValue(name, out List<string>? files))
+        {
+            foreach (string file in files.Where(f => !_walkedFiles.Contains(f)).Take(extraZones).ToList())
+            {
+                WalkFile(file);
+                Consider();
+                if (best != null)
+                    break;
+            }
+        }
+        if (best == null)
+        {
+            _log($"donor {name}: every loaded PS4 copy drags in non-shader assets; using {zone!.Label}");
+            return true;
+        }
+        zone = best.Value.Zone;
+        asset = best.Value.Asset;
+        clean = true;
+        return true;
+    }
+
+    private readonly Dictionary<(T7WalkIndex Zone, int Asset), bool> _selfContained = [];
+
+    private bool SelfContained(T7WalkIndex zone, T7Walk.Asset asset)
+    {
+        if (_selfContained.TryGetValue((zone, asset.Index), out bool known))
+            return known;
+        bool contained = true;
+        var spans = new List<(long Start, long Size)> { (asset.Start, asset.End - asset.Start) };
+        spans.AddRange(asset.Deferred.Select(d => (d.FileOffset, d.Size)));
+        foreach ((long start, long size) in spans)
+        {
+            foreach ((long field, T7PointerKind kind, T7BlockAddress target) in zone.PointersIn(start, size))
+            {
+                if (kind is not (T7PointerKind.Packed or T7PointerKind.PackedAlias))
+                    continue;
+                int other = ReferencedAsset(zone, field, target);
+                if (other >= 0 && other != asset.Index)
+                    contained = false;
+                if (!contained)
+                    break;
+            }
+            if (!contained)
+                break;
+        }
+        _selfContained[(zone, asset.Index)] = contained;
+        return contained;
+    }
