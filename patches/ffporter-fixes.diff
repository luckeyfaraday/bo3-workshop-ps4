+    // The PS4 technique set closest to `ps4Name` (same folder and '#hash' family, most shared name words) that a donor
+    // zone can supply, for texturecombo techsets no PS4 zone has and no compiler can build.
+    // Name words `substitute` has that `original` lacks: features the substitute adds (it may sample textures the
+    // material doesn't have, which crashes the renderer where the surface is drawn). Empty for a safe substitute.
+    public static string AddedFeatures(string original, string substitute)
+    {
+        string[] have = Parts(original).Words, got = Parts(substitute).Words;
+        string extra = string.Join(",", got.Where(w => !have.Contains(w)));
+        return extra.Length == 0 ? "" : $" [ADDS {extra}: may crash where drawn]";
+    }
