+    private static int AddDonorDependencies(T7ZoneBuilder builder, T7DonorLibrary donors, IEnumerable<(T7WalkIndex Zone, T7Walk.Asset Asset)> inline, Action<string> log, int limit = 256)
+    {
+        var queue = new Queue<(T7WalkIndex Zone, T7Walk.Asset Asset)>(inline);
+        foreach (T7OutputAsset output in builder.Assets.ToList())
+        {
+            if (!output.Origin.StartsWith("donor ", StringComparison.Ordinal))
+                continue;
+            string[] parts = output.Origin[6..].Split('#');
+            T7WalkIndex? zone = donors.Zones.FirstOrDefault(z => z.Label == parts[0]);
+            if (zone != null && parts.Length > 1 && int.TryParse(parts[1], out int index) && index < zone.Walk.Assets.Count)
+                queue.Enqueue((zone, zone.Walk.Assets[index]));
+        }
+        int added = 0;
+        while (queue.Count > 0)
+        {
+            (T7WalkIndex zone, T7Walk.Asset asset) = queue.Dequeue();
+            var spans = new List<(long Start, long Size)> { (asset.Start, asset.End - asset.Start) };
+            spans.AddRange(asset.Deferred.Select(d => (d.FileOffset, d.Size)));
+            foreach ((long start, long size) in spans)
+            {
+                foreach ((long field, T7PointerKind kind, T7BlockAddress target) in zone.PointersIn(start, size))
+                {
+                    if (kind is not (T7PointerKind.Packed or T7PointerKind.PackedAlias))
+                        continue;
+                    int other = T7DonorLibrary.ReferencedAsset(zone, field, target);
+                    if (other < 0 || other == asset.Index)
+                        continue;
+                    T7Walk.Asset shared = zone.Walk.Assets[other];
+                    if (shared.Type is not (T7AssetTypes.TechniqueSet or T7AssetTypes.ComputeShaderSet))
+                    {
+                        // Only shader sets come along: anything else a borrowed shader set touches (a model or weapon
+                        // that happens to hold shared data) would drag in half the zone. The link reports what's left.
+                        log($"donor dependency: not carrying {T7AssetTypes.Name(shared.Type)} '{shared.Name}' ({zone.Label}#{other}) for '{asset.Name}'");
+                        continue;
+                    }
+                    if (builder.TryMapped(zone, other, out int mapped))
+                    {
+                        // Already in the output as this exact build: fine. Another build of it (a different zone's, or the
+                        // map's own): carry this one too, so the pointers land on its data.
+                        if (builder.Assets[mapped].Origin == $"donor {zone.Label}#{other}")
+                            continue;
+                    }
+                    if (added >= limit)
+                    {
+                        log($"donor dependencies: stopped at {limit} carried assets");
+                        return added;
+                    }
+                    T7Walk.Asset dependency = zone.Walk.Assets[other];
+                    var extra = new T7OutputAsset { Type = dependency.Type, Name = dependency.Name, HeaderMarker = ulong.MaxValue };
+                    T7CopyConverter.CopyWhole(zone, dependency, extra);
+                    extra.Origin = $"donor {zone.Label}#{dependency.Index}";
+                    builder.Assets.Add(extra);
+                    builder.MapAsset(zone, dependency.Index, builder.Assets.Count - 1);
+                    queue.Enqueue((zone, dependency));
+                    added++;
+                    log($"donor dependency: carried {T7AssetTypes.Name(dependency.Type)} '{dependency.Name}' ({zone.Label}#{dependency.Index}) for '{asset.Name}'");
+                }
+            }
+        }
+        return added;
+    }
